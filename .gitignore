# dependencies
/node_modules

# next.js
/.next
/out
next-env.d.ts

# production
/build

# prisma — throwaway SQLite data is regenerated by `npm run seed`
/prisma/dev.db
/prisma/dev.db-journal
*.db
*.db-journal

# env — never commit real env files; keep the example
.env
.env.*
!.env.example

# test artifacts
/test-results
/playwright-report
/blob-report
/playwright/.cache

# typescript build info
*.tsbuildinfo

# inbox — friends' raw idea docs never enter repo history
**/inbox/*
!**/inbox/.gitkeep
!**/inbox/README.md
# Raw customer-session notes stay local; evidence summaries use anonymous IDs.
**/feedback/*
!**/feedback/.gitkeep
!**/feedback/README.md

# misc
.DS_Store
*.pem
npm-debug.log*

# Operator research traces may contain founder material and source excerpts.
**/.foundry/research/
__pycache__/

# Local cross-tool checkpoints may describe private work in progress.
**/.foundry/handoffs/

# Reviewed learning records can contain private founder context.
**/.foundry/corrections/
**/.foundry/registry.lock
**/.foundry/*.local.json
**/.foundry/prototype.lock
# Local tool permissions are machine-specific; keep shared configuration trackable.
**/.claude/settings.local.json

# Private workflow snapshots, host events and review labels.
**/.foundry/executions/
